{
    "$schema": "https://schema.tauri.app/config/2/capability",
    "identifier": "default",
    "description": "Default permissions for Notehub.md desktop app",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "fs:default",
        "fs:allow-read",
        "fs:allow-write",
        "fs:allow-exists",
        "fs:allow-mkdir",
        "fs:allow-read-dir",
        "fs:allow-read-file",
        "fs:allow-read-text-file",
        "fs:allow-write-file",
        "fs:allow-write-text-file"
    ]
}