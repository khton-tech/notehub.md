{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Notehub.md",
    "version": "0.1.6",
    "identifier": "md.notehub.desktop",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:1420",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Notehub.md",
                "width": 1200,
                "height": 800,
                "resizable": true,
                "fullscreen": false,
                "decorations": false,
                "transparent": false,
                "backgroundColor": "#1a1a1a",
                "devtools": true,
                "dragDropEnabled": true
            }
        ],
        "security": {
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**",
                    "$RESOURCE/**",
                    "$HOME/**"
                ]
            }
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    },
    "plugins": {
        "fs": {}
    }
}